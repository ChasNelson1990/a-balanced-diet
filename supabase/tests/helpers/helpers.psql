-- Test-only helpers. Sourced from each test file with `\ir ../helpers/helpers.psql`
-- AFTER `begin;`, so everything here lives inside the test transaction and
-- is rolled back. Never reaches migrations.
create schema tests;
grant usage on schema tests to anon, authenticated;

create function tests.create_user(email text) returns uuid
language plpgsql as $$
declare
  uid uuid := gen_random_uuid();
begin
  insert into auth.users (id, instance_id, aud, role, email)
  values (uid, '00000000-0000-0000-0000-000000000000', 'authenticated', 'authenticated', email);
  return uid;
end $$;

create function tests.act_as(uid uuid) returns void
language plpgsql as $$
begin
  set local role authenticated;
  perform set_config('request.jwt.claims',
    json_build_object('sub', uid, 'role', 'authenticated')::text, true);
end $$;
grant execute on function tests.create_user(text), tests.act_as(uuid) to anon, authenticated;
